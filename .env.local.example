# Anthropic API key — https://platform.claude.com
ANTHROPIC_API_KEY=

# Supabase project settings — Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Signs the session cookie used for guest/account login (see src/lib/auth.ts).
# Any long random string — e.g. `openssl rand -hex 32`. Required in
# production (signup/login/guest all fail closed without it); falls back to
# a fixed, insecure dev-only value if unset locally.
SESSION_SECRET=

# The one owner/admin login — sees every guest's and every account's usage
# in /dashboard, not just their own. Not a database row; checked directly
# against these two values. Required in production; defaults to admin/admin
# in local dev only. Change this before deploying.
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=
